# @simone98dm/* is published to GitHub Packages, not the public registry.
# Only the scope->registry mapping lives here. The auth token deliberately does
# NOT: yarn 1 aborts every command (even `yarn run`) when an ${ENV} placeholder
# in .npmrc is unset. Authenticate once per machine instead:
#   npm config set //npm.pkg.github.com/:_authToken=$(gh auth token)
# CI gets it from actions/setup-node (registry-url + scope) plus NODE_AUTH_TOKEN.
@simone98dm:registry=https://npm.pkg.github.com

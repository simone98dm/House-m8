# =============================================================================
# DATABASE PROVIDER CONFIGURATION
# =============================================================================
# Choose your database provider: 'postgres'
DB_PROVIDER=postgres

# =============================================================================
# POSTGRESQL CONFIGURATION
# =============================================================================
# Option 1: Individual connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=house_m8
POSTGRES_USER=house_m8_user
POSTGRES_PASSWORD=your_secure_password

# Option 2: Connection URL (takes precedence if set)
POSTGRES_URL=postgresql://house_m8_user:your_secure_password@localhost:5432/house_m8

# JWT Secret for PostgreSQL authentication (change this in production!)
# Generate a random secret with: openssl rand -base64 32
JWT_SECRET=your_random_jwt_secret_at_least_32_chars_long

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Optional: For local development
NUXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Seed User Configuration
SEED_USER_PASSWORD=your_default_password

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="House M8 <noreply@housem8.app>"

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cron job authentication (used by /api/cron/* endpoints)
# Generate with: openssl rand -base64 32
CRON_SECRET=your_cron_secret

# Stripe (required for billing/subscription features)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_PRO_ANNUAL=price_...
STRIPE_PRICE_ID_HOUSE_PLUS_MONTHLY=price_...
STRIPE_PRICE_ID_HOUSE_PLUS_ANNUAL=price_...

# Feature Flags
# Provider options: env (default, reads FEATURE_FLAG_* vars below) | vercel (requires EDGE_CONFIG)
FEATURE_FLAGS_PROVIDER=env
# EDGE_CONFIG=ecfg_...
FEATURE_FLAG_STRIPE_INTEGRATION=false

# =============================================================================
# QUICK START EXAMPLES
# =============================================================================

# --- Local Development with PostgreSQL ---
# DB_PROVIDER=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=house_m8
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# --- Production with PostgreSQL (Railway, Render, etc.) ---
# DB_PROVIDER=postgres
# POSTGRES_URL=postgresql://user:password@host.railway.app:5432/railway
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="House M8 <noreply@yourdomain.com>"
# BASE_URL=https://yourdomain.com
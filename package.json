{
  "name": "house-m8",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build --dotenv .env.production",
    "dev": "nuxt dev --dotenv .env.development",
    "generate": "nuxt generate --dotenv .env.production",
    "preview": "nuxt preview --dotenv .env.production",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "format:commit": "commitlint --edit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "yarn test:unit && yarn test:integration && yarn test:api",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run app/__tests__ app/components app/composables app/stores app/layouts app/middleware shared/utils",
    "test:integration": "vitest run app/pages",
    "test:api": "vitest run server/__tests__",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headed": "cypress run --headed",
    "test:e2e:ci": "start-server-and-test dev http://localhost:3000 test:e2e",
    "lighthouse": "start-server-and-test preview http://localhost:3000 \"lhci autorun\"",
    "lighthouse:dev": "lighthouse http://localhost:3000 --view --output html --output-path ./lighthouse-report.html",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:admin": "tsx scripts/db-admin.ts",
    "generate-emails": "tsx scripts/generate-email-previews.ts",
    "typecheck": "nuxt typecheck",
    "sonar": "npx sonar-scanner -Dsonar.host.url=http://localhost:9000 -Dsonar.token=$SONAR_TOKEN"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@nuxt/eslint": "1.9.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "2.0.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "4.0.3",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.1.0",
    "@nuxtjs/tailwindcss": "^6.12.1",
    "@pinia/nuxt": "^0.11.2",
    "@simone98dm/layer": "^1.0.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@types/pg": "^8.15.6",
    "@vercel/edge-config": "^1.4.3",
    "@vite-pwa/nuxt": "^0.10.5",
    "bcrypt": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "consola": "^3.4.2",
    "eslint": "^9.0.0",
    "jose": "^6.1.0",
    "jspdf": "^4.2.1",
    "nuxt": "^4.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "pinia": "^3.0.3",
    "resend": "^6.4.1",
    "stripe": "^22.1.1",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@cypress/vue": "^6.0.2",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/mdi": "^1.2.3",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/bcrypt": "^6.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.8",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.9.6",
    "cypress": "^15.6.0",
    "dotenv": "^17.2.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "lighthouse": "^13.0.1",
    "lint-staged": "^16.2.3",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "sass": "^1.102.0",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.9"
  },
  "version": "0.9.0"
}
